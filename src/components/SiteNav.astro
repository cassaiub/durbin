---
/* Top bar: the Durbin wordmark and the primary links. Mobile gets a
   full-screen overlay menu (checkbox-free: a small script toggles state). */
import { Image } from "astro:assets";
import { NAV } from "../data/site";
import durbinLogo from "../assets/brand/durbin-logo.jpg";

interface Props {
  current?: string;
}
const { current = "" } = Astro.props;

const items = NAV.map((it) => ({ ...it, active: current === it.path }));
---

<header class:list={["nav", { "nav--overlay": current === "/" }]} data-nav>
  <div class="nav__bar">
    <a class="nav__brand" href="/" aria-label="Durbin">
      <span class="nav__mark" aria-hidden="true">
        <Image class="nav__logo" src={durbinLogo} alt="" width={42} height={42} densities={[1, 2]} loading="eager" />
      </span>
      <span class="nav__word">
        <span class="nav__name">Durbin</span>
      </span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {items.map((it) => (
        <a
          class:list={["nav__link", { "is-active": it.active }]}
          href={it.path}
          data-astro-reload={it.path === "/exhibition" ? true : undefined}
          aria-current={current === it.path ? "page" : undefined}
        >{it.label}</a>
      ))}
    </nav>

    <div class="nav__end">
      <a
        class:list={["btn", "btn--solid", "nav__manual", { "is-active": current === "/manual" }]}
        href="/manual"
        aria-current={current === "/manual" ? "page" : undefined}
      >
        <svg class="nav__manual-icon" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M10 3v9m0 0 3.25-3.25M10 12 6.75 8.75M4 16h12" />
        </svg>
        <span>Manual</span>
      </a>
      <button class="nav__burger" type="button" aria-expanded="false" aria-controls="nav-overlay" data-nav-toggle>
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <span class="nav__burger-line"></span>
        <span class="nav__burger-line"></span>
      </button>
    </div>
  </div>

  <div class="nav__overlay" id="nav-overlay" role="dialog" aria-modal="true" aria-labelledby="nav-overlay-title" hidden>
    <h2 class="visually-hidden" id="nav-overlay-title">Site menu</h2>
    <button class="nav__overlay-close" type="button" aria-label="Close menu" data-nav-close>&times;</button>
    <nav aria-label="Primary">
      <ol class="nav__olist">
        {items.map((it) => (
          <li class="nav__oitem">
            <a
              class:list={["nav__olink", { "is-active": it.active }]}
              href={it.path}
              data-astro-reload={it.path === "/exhibition" ? true : undefined}
              aria-current={current === it.path ? "page" : undefined}
            >{it.label}</a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset-inline: 0; top: 0; z-index: 50;
    transition: padding 0.82s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav__bar {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-md);
    box-sizing: border-box; width: 100%; margin-inline: auto;
    overflow: clip;
    padding: 0.75rem clamp(var(--space-sm), 4vw, var(--space-lg));
    background: var(--night);
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    box-shadow: none;
    backdrop-filter: blur(0) saturate(100%);
    -webkit-backdrop-filter: blur(0) saturate(100%);
    transition:
      width 0.82s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.82s cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 0.82s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.68s ease,
      backdrop-filter 0.82s cubic-bezier(0.22, 1, 0.36, 1),
      -webkit-backdrop-filter 0.82s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav--overlay .nav__bar {
    border: 0;
    outline: 0;
  }
  .nav--overlay {
    --ink: #ffffff;
    --ink-soft: rgba(255, 255, 255, 0.84);
    --ink-faint: rgba(255, 255, 255, 0.68);
    --brass: var(--manila);
    --brass-bright: var(--brand-green-mid);
    --brass-dim: color-mix(in srgb, var(--manila) 30%, transparent);
    padding: 0.7rem 0 0;
  }
  .nav--overlay:not([data-scrolled]) .nav__bar {
    width: min(100%, var(--wrap));
    border-radius: var(--radius-circle);
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .nav--overlay[data-scrolled] .nav__bar {
    width: min(100%, 58rem);
    margin-inline: auto;
    padding: 0.55rem 0.75rem 0.55rem 0.65rem;
    border-radius: var(--radius-circle);
    background: rgba(255, 255, 255, 0.16);
    border: 0;
    box-shadow: none;
    backdrop-filter: blur(32px) saturate(135%);
    -webkit-backdrop-filter: blur(32px) saturate(135%);
  }
  .nav--overlay[data-scrolled] { padding-inline: clamp(0.75rem, 3vw, 2rem); }
  .nav__brand { display: flex; align-items: center; gap: 0.75rem; }
  .nav__mark { display: grid; place-items: center; }
  .nav__word { display: flex; align-items: center; line-height: 1.1; }
  .nav__name { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.03em; color: var(--ink); }

  .nav__links { display: flex; align-items: center; gap: clamp(1.25rem, 2.5vw, 2rem); }
  .nav__link {
    font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; line-height: 1.25;
    color: var(--ink-soft); padding: 0.5rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .nav__link:hover { color: var(--ink); }
  .nav__link.is-active { color: var(--brass-bright); border-bottom-color: var(--brass); }

  .nav__end { display: flex; align-items: center; gap: 0.9rem; }
  .nav__manual {
    flex: none; padding: 0.5rem 0.95rem; border-radius: var(--radius-circle);
    border-color: #ffffff; color: #0a0a0a; background: #ffffff;
    box-shadow: none; font-size: 0.86rem; white-space: nowrap;
  }
  .nav__manual:hover { border-color: #e5e5e5; color: #0a0a0a; background: #e5e5e5; }
  .nav__manual:active { transform: translateY(0); border-color: #cfcfcf; color: #0a0a0a; background: #cfcfcf; }
  .nav__manual-icon {
    width: 1rem; height: 1rem; fill: none; stroke: currentColor;
    stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round;
  }
  .nav__manual.is-active { outline: 1px solid var(--ink); outline-offset: 2px; }

  .nav__burger { display: none; position: relative; width: 40px; height: 40px; }
  .nav__burger-line {
    position: absolute; left: 9px; right: 9px; height: 2px; background: var(--ink);
    transition: translate 0.25s, rotate 0.25s;
  }
  .nav__burger-line:nth-child(2) { top: 16px; }
  .nav__burger-line:nth-child(3) { top: 24px; }
  .nav[data-open] .nav__burger-line:nth-child(2) { top: 20px; rotate: 45deg; }
  .nav[data-open] .nav__burger-line:nth-child(3) { top: 20px; rotate: -45deg; }

  .nav__overlay[hidden] { display: none; }
  .nav__overlay {
    position: fixed; inset: 0; z-index: 2;
    background: var(--night);
    display: grid; align-content: center;
    padding: 5.5rem clamp(1.4rem, 6vw, 3rem) 3rem;
  }
  .nav__overlay-close {
    position: absolute; top: 0.8rem; right: clamp(1.1rem, 4vw, 2.4rem);
    display: grid; place-items: center; width: 44px; height: 44px;
    font-size: 2rem; line-height: 1; color: var(--ink-soft);
  }
  .nav__overlay-close:hover { color: var(--brass-bright); }
  .nav__olist { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
  .nav__oitem { min-width: 0; }
  .nav__olink {
    display: block; padding: 0.7rem 0;
    font-family: var(--font-display); font-size: clamp(2rem, 8vw, 2.8rem); font-weight: 600;
    line-height: 1.05; letter-spacing: -0.03em;
    color: var(--ink-soft); border-bottom: 1px solid var(--line-soft);
    transition: color 0.2s;
  }
  .nav__olink:hover, .nav__olink.is-active { color: var(--brass-bright); }
  @media (max-width: 860px) {
    .nav__links { display: none; }
    .nav__burger { display: block; }
    .nav--overlay[data-scrolled] { padding: 0.5rem 0.55rem 0; }
    .nav--overlay[data-scrolled] .nav__bar { border-radius: var(--radius-card-compact); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav, .nav__bar { transition-duration: 0.01ms; }
  }
</style>

<script>
  let navController: AbortController | undefined;

  const setupSiteNav = () => {
    navController?.abort();
    navController = new AbortController();
    const { signal } = navController;
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    const toggle = nav?.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const overlay = nav?.querySelector<HTMLElement>(".nav__overlay");
    const bar = nav?.querySelector<HTMLElement>(".nav__bar");
    const closeBtn = overlay?.querySelector<HTMLButtonElement>("[data-nav-close]");
    const menuLabel = toggle?.querySelector<HTMLElement>("[data-menu-label]");
  if (nav?.classList.contains("nav--overlay")) {
    const syncSurface = () => {
      const isCompact = nav.hasAttribute("data-scrolled");
      if (!isCompact && scrollY > 24) nav.setAttribute("data-scrolled", "");
      else if (isCompact && scrollY < 6) nav.removeAttribute("data-scrolled");
    };
    syncSurface();
    addEventListener("scroll", syncSurface, { passive: true, signal });
  }
  if (nav && toggle && overlay && bar && closeBtn) {
    const background = Array.from(
      document.querySelectorAll<HTMLElement>("body > .skip, body > main, body > footer, body > .lightbox"),
    );
    const inertState = new Map<HTMLElement, boolean>();
    let restoreFocus: HTMLElement | null = null;
    const focusable = () => Array.from(
      overlay.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'),
    ).filter((el) => !el.hasAttribute("hidden") && el.getClientRects().length > 0);

    const set = (open: boolean, restore = true) => {
      if (open === !overlay.hidden) return;
      nav.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      if (menuLabel) menuLabel.textContent = open ? "Close menu" : "Open menu";
      if (open) {
        restoreFocus = document.activeElement instanceof HTMLElement ? document.activeElement : toggle;
        overlay.hidden = false;
        bar.inert = true;
        for (const el of background) {
          inertState.set(el, el.inert);
          el.inert = true;
        }
        requestAnimationFrame(() => overlay.querySelector<HTMLAnchorElement>(".nav__olink")?.focus());
      } else {
        overlay.hidden = true;
        bar.inert = false;
        for (const el of background) el.inert = inertState.get(el) ?? false;
        inertState.clear();
        if (restore) (restoreFocus ?? toggle).focus();
        restoreFocus = null;
      }
      document.body.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () => set(true), { signal });
    closeBtn.addEventListener("click", () => set(false), { signal });
    overlay.addEventListener("keydown", (e) => {
      if (e.key !== "Tab") return;
      const items = focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }, { signal });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !overlay.hidden) {
        e.preventDefault();
        set(false);
      }
    }, { signal });
    window.addEventListener("resize", () => {
      if (innerWidth > 860 && !overlay.hidden) set(false, false);
    }, { signal });
  }
  };

  setupSiteNav();
  document.addEventListener("astro:page-load", setupSiteNav);
</script>
