---
import { Image } from "astro:assets";
import { SITE } from "../data/site";
import durbinLogo from "../assets/brand/durbin-logo.jpg";
import britishCouncilLogo from "../assets/partners/british-council.webp";
import cassaLogo from "../assets/partners/cassa-white.svg";
import iubLogo from "../assets/partners/iub.png";
import dunlapLogo from "../assets/partners/dunlap-white.png";
import whitinLogo from "../assets/partners/whitin-observatory.png";

// Pixabay video 217245 by olenchic, used under the Pixabay Content License.
// It is stored locally so the footer is not dependent on a third-party request.
const footerVideo = "/videos/pixabay-moon-night-217245.mp4";
const footerPoster = "/videos/pixabay-moon-night-217245.jpg";
const partners = [
  { href: "https://cassa.bd/", alt: "Independent University, Bangladesh and CASSA", logo: cassaLogo, size: "host" },
  { href: "https://www.dunlap.utoronto.ca/", alt: "Dunlap Institute for Astronomy and Astrophysics", logo: dunlapLogo, size: "dunlap" },
  { href: "https://www.britishcouncil.org.bd/", alt: "British Council Bangladesh", logo: britishCouncilLogo, size: "british" },
  { href: "https://www.wellesley.edu/whitin-observatory", alt: "Whitin Observatory at Wellesley College", logo: whitinLogo, size: "whitin" },
];
---

<footer class="foot">
  <div class="foot__media" aria-hidden="true">
    <video
      class="foot__video"
      muted
      loop
      playsinline
      preload="none"
      poster={footerPoster}
      data-footer-video
    >
      <source src={footerVideo} type="video/mp4" />
    </video>
  </div>
  <div class="foot__scrim" aria-hidden="true"></div>

  <div class="wrap foot__main">
    <a class="foot__brand" href="/" aria-label="Durbin home">
      <Image class="foot__logo" src={durbinLogo} alt="" width={64} height={64} densities={[1, 2]} loading="lazy" />
      <span>
        <span class="foot__word">Durbin</span>
        <span class="foot__tag">Citizen of distant world</span>
      </span>
    </a>

    <div class="foot__contact" aria-label="Contact Durbin">
      <a class="foot__contact-item" href={`mailto:${SITE.email}`}>
        <span class="foot__contact-label">Project manager</span>
        <span class="foot__contact-value">Contact <span aria-hidden="true">↗</span></span>
      </a>
      <a class="foot__contact-item" href={SITE.facebook} target="_blank" rel="noopener">
        <span class="foot__contact-label">Follow</span>
        <span class="foot__contact-value">Facebook <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </div>

  <div class="wrap foot__support" aria-label="Durbin host and supporting institutions">
    <p class="foot__support-label">Hosted &amp; supported by</p>
    <div class="foot__partners">
      {partners.map((partner) => (
        <a class={`foot__partner foot__partner--${partner.size}`} href={partner.href} target="_blank" rel="noopener">
          {partner.size === "host" ? (
            <span class="foot__host-lockup">
              <img class="foot__iub" src={iubLogo.src} alt="Independent University, Bangladesh" loading="lazy" decoding="async" />
              <i aria-hidden="true"></i>
              <img class="foot__cassa" src={cassaLogo.src} alt="CASSA" loading="lazy" decoding="async" />
            </span>
          ) : <img src={partner.logo.src} alt={partner.alt} loading="lazy" decoding="async" />}
        </a>
      ))}
    </div>
  </div>

</footer>

<style>
  .foot {
    --ink: var(--photo-ink);
    --ink-soft: var(--photo-ink-soft);
    --ink-faint: var(--photo-ink-faint);
    --brass: var(--manila);
    --brass-bright: var(--brand-green-mid);
    --line-soft: color-mix(in srgb, var(--manila) 18%, transparent);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(2.75rem, 6vw, 4.75rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
    color: var(--photo-ink);
    background: var(--night);
  }
  .foot__media, .foot__scrim { position: absolute; inset: 0; }
  .foot__media { z-index: -2; background: #000; }
  .foot__video { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .foot__scrim {
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.88)),
      linear-gradient(to right, rgba(0, 0, 0, 0.32), transparent 55%);
  }
  .foot__main {
    display: grid; grid-template-columns: minmax(15rem, 1fr) auto;
    align-items: center; gap: 2.5rem; padding-bottom: 1.75rem;
  }
  .foot__brand { display: inline-flex; align-items: center; gap: 0.9rem; width: fit-content; }
  .foot__logo { width: 58px; height: 58px; border-radius: var(--radius-circle); object-fit: cover; }
  .foot__word { display: block; font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; letter-spacing: -0.03em; color: var(--ink); }
  .foot__tag {
    display: block; margin-top: 0.2rem; font-family: var(--font-body);
    font-size: 0.76rem; font-weight: 450; letter-spacing: 0.01em; color: var(--ink-faint);
  }
  .foot__contact {
    display: grid; grid-template-columns: minmax(15rem, auto) minmax(6rem, auto);
    align-items: start; justify-content: end; gap: clamp(1.5rem, 4vw, 3.25rem);
  }
  .foot__contact-item { display: grid; gap: 0.3rem; color: var(--ink-soft); transition: color 0.2s; }
  .foot__contact-label {
    color: var(--ink-faint); font-family: var(--font-body); font-size: 0.68rem;
    font-weight: 600; letter-spacing: 0; text-transform: uppercase;
  }
  .foot__contact-value { font-size: 0.88rem; line-height: 1.35; }
  .foot__contact-item:hover { color: var(--ink); }
  .foot__support {
    padding: clamp(1.35rem, 2.8vw, 2rem) clamp(1.25rem, 3.5vw, 2.75rem);
    border: 0;
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow-low), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(24px) saturate(130%);
    -webkit-backdrop-filter: blur(24px) saturate(130%);
  }
  .foot__support-label {
    color: var(--ink-faint); font-family: var(--font-body); font-size: 0.72rem;
    font-weight: 600; letter-spacing: 0; text-transform: uppercase;
    margin-bottom: 1.35rem;
  }
  .foot__partners {
    display: grid; grid-template-columns: 1.45fr 1.7fr 0.9fr 1.3fr;
    align-items: center; gap: clamp(1.5rem, 5vw, 4.5rem);
  }
  .foot__partner { display: grid; place-items: center; min-width: 0; height: 38px; opacity: 0.58; transition: opacity 0.2s; }
  .foot__partner--host { transform: scale(1.05); transform-origin: center; }
  .foot__partner:hover { opacity: 0.86; }
  .foot__partner img { width: 100%; height: 100%; object-fit: contain; filter: grayscale(1) brightness(0) invert(1); }
  .foot__host-lockup { display: grid; grid-template-columns: 3.685rem 1px 5.885rem; align-items: center; justify-content: center; gap: .715rem; width: fit-content; max-width: 100%; height: 41.8px; margin-inline: auto; }
  .foot__host-lockup i { align-self: center; width: 1px; height: 30.8px; background: rgba(255,255,255,.32); }
  .foot__partner .foot__host-lockup img { width: 100%; height: 37.4px; max-width: 100%; object-position: center; }
  .foot__partner .foot__iub { object-fit: contain; }
  .foot__partner .foot__cassa { object-fit: contain; }
  .foot__partner--dunlap img { max-width: 14.75rem; transform: scale(1.12); }
  .foot__partner--british img { max-width: 7rem; }
  .foot__partner--whitin img { max-width: 11.75rem; }
  @media (max-width: 760px) {
    .foot__main { grid-template-columns: 1fr; gap: 1.4rem; }
    .foot__contact { grid-template-columns: 1fr 0.75fr; justify-content: stretch; }
    .foot__partners { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem 2rem; }
    .foot__partner { place-items: center start; }
    .foot__host-lockup { grid-template-columns: 2.75rem 1px 4.25rem; gap: .45rem; height: 32px; margin-inline: 0; }
    .foot__partner .foot__host-lockup img { height: 29px; }
    .foot__host-lockup i { height: 23px; }
  }

  @media (max-width: 420px) {
    .foot__contact { grid-template-columns: 1fr; gap: 1rem; }
  }

</style>

<script>
  let footerController: AbortController | undefined;
  let footerObserver: IntersectionObserver | undefined;

  const setupFooterVideo = () => {
    footerController?.abort();
    footerObserver?.disconnect();
    footerController = new AbortController();
    const footerVideo = document.querySelector<HTMLVideoElement>("[data-footer-video]");
    if (!footerVideo) return;

    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let visible = false;

    const syncPlayback = () => {
      if (motion.matches || !visible) footerVideo.pause();
      else void footerVideo.play().catch(() => {
        /* The matching poster remains visible if autoplay is unavailable. */
      });
    };

    footerObserver = new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
      syncPlayback();
    }, { rootMargin: "240px 0px" });

    footerObserver.observe(footerVideo);
    motion.addEventListener("change", syncPlayback, { signal: footerController.signal });
  };

  setupFooterVideo();
  document.addEventListener("astro:page-load", setupFooterVideo);
</script>
