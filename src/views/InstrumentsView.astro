---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/Reveal.astro";

interface Props { mode:"telescope"|"equipment" }
const { mode }=Astro.props;
const telescope=mode==="telescope";
const items=telescope?[
  {index:"01",name:"Unistellar eQuinox 1",kind:"Smart telescope",text:"A robotic, app-controlled telescope used for deep-sky observing and live digital views of galaxies, nebulae and clusters. Durbin began with two eQuinox instruments in 2023.",facts:["Digital observation","Enhanced vision","Deep-sky imaging"]},
  {index:"02",name:"Sky-Watcher 200P",kind:"Manual reflector",text:"An 8-inch optical reflector for direct observation through an eyepiece—especially rewarding for the Moon, planets and bright deep-sky objects.",facts:["200 mm aperture","Optical eyepiece","Planetary viewing"]},
  {index:"03",name:"Celestron 200AZ",kind:"Portable reflector",text:"A field-friendly telescope used in school outreach and practical demonstrations, helping students understand alignment, focus and the path of light.",facts:["Portable setup","Hands-on learning","Outreach fieldwork"]},
]:[
  {index:"01",name:"Imaging kit",kind:"Capture & processing",text:"Phones, tablets and computers connect the observing field to image capture, stacking, processing and the public screen.",facts:["Mobile control","Image processing","Live display"]},
  {index:"02",name:"Optical accessories",kind:"At the telescope",text:"Eyepieces and observing accessories adapt an instrument to different targets and make public viewing sessions easier to guide.",facts:["Eyepieces","Target changes","Visual observing"]},
  {index:"03",name:"Field support",kind:"Ready for the night",text:"Tripods, power, protective cases and practical outreach materials keep mobile sessions safe, organised and resilient away from the observatory.",facts:["Stable mounting","Portable power","Protective transport"]},
];
const title=telescope?"Telescopes":"Equipment";
const lede=telescope?"The instruments Durbin uses to turn distant light into a shared public experience.":"The supporting field and imaging kit that keeps an observing session moving.";
---

<BaseLayout path={`/instruments/${mode}`} title={`${title} | Durbin`} current="/instruments" description={lede}>
  <header class="instrument-head">
    <div class="wrap instrument-head__grid">
      <Reveal><p class="section-label">Instruments / {title}</p><h1>{telescope?<>Light, gathered<br/>in three ways.</>:<>The kit behind<br/>the view.</>}</h1></Reveal>
      <Reveal delay={80}><p>{lede}</p><div class="instrument-switch"><a class:list={[{active:telescope}]} href="/instruments/telescope">Telescope</a><a class:list={[{active:!telescope}]} href="/instruments/equipment">Equipment</a></div></Reveal>
    </div>
  </header>
  <section class="instrument-list section--line">
    <div class="wrap">
      {items.map((item,i)=><article class="instrument" data-reveal style={`--reveal-delay:${i*55}ms`}>
        <div class="instrument__number mono">{item.index}</div>
        <div class:list={["instrument__glyph",{ "instrument__glyph--gear":!telescope}]} aria-hidden="true"><span></span><i></i></div>
        <div class="instrument__copy"><p>{item.kind}</p><h2>{item.name}</h2><div><p>{item.text}</p><ul>{item.facts.map(fact=><li>{fact}</li>)}</ul></div></div>
      </article>)}
    </div>
  </section>
  <section class="section instrument-close"><div class="wrap"><Reveal><p class="section-label">See what the instruments make possible</p><h2>The light continues in the exhibition.</h2><a class="btn btn--solid" href="/exhibition" data-astro-reload>Enter the exhibition</a></Reveal></div></section>
</BaseLayout>

<style>
  .instrument-head{padding:clamp(8rem,14vw,10rem) 0 clamp(3.5rem,7vw,5.5rem);background:radial-gradient(circle at 15% 80%,color-mix(in srgb,var(--brass) 18%,transparent),transparent 26%)}.instrument-head__grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,8vw,7rem);align-items:end}.instrument-head h1{margin-top:.8rem;max-width:13ch;font-size:clamp(2.75rem,6.5vw,5.25rem);line-height:.94;letter-spacing:-.06em;text-wrap:balance}.instrument-head__grid>div:last-child>p{color:var(--ink-soft);font-size:1.04rem;line-height:1.65}.instrument-switch{display:flex;gap:.4rem;margin-top:1.4rem}.instrument-switch a{padding:.55rem .85rem;border:1px solid var(--line);border-radius:999px;color:var(--ink-faint);font-size:.76rem;font-weight:600}.instrument-switch a.active{background:var(--brass);color:var(--on-brass);border-color:var(--brass)}
  .instrument-list{padding:0 0 var(--space-section)}.instrument{display:grid;grid-template-columns:3rem clamp(8rem,18vw,13rem) minmax(0,1fr);gap:clamp(1rem,5vw,4rem);align-items:center;padding:clamp(2rem,5vw,4rem) 0;border-bottom:1px solid var(--line)}.instrument__number{align-self:start;color:var(--ink-faint);font-size:.72rem}.instrument__glyph{position:relative;aspect-ratio:1;border:1px solid var(--line);border-radius:50%;background:radial-gradient(circle at 50% 50%,color-mix(in srgb,var(--brass) 20%,transparent),transparent 55%);transform:rotate(-18deg)}.instrument__glyph:before{content:"";position:absolute;left:14%;right:14%;top:43%;height:14%;border:2px solid var(--ink-soft);border-radius:999px;transform:skewX(-16deg)}.instrument__glyph span{position:absolute;left:24%;top:34%;width:17%;height:32%;border:2px solid var(--ink-soft);border-radius:50%}.instrument__glyph i{position:absolute;left:48%;bottom:13%;width:2px;height:32%;background:var(--ink-soft);box-shadow:-25px 24px 0 -1px var(--ink-soft),25px 24px 0 -1px var(--ink-soft)}.instrument__glyph--gear:before{left:28%;right:28%;top:28%;height:44%;border-radius:24%;transform:rotate(45deg)}.instrument__glyph--gear span{left:40%;top:40%;width:20%;height:20%;border-radius:50%}.instrument__glyph--gear i{display:none}.instrument__copy>p{color:var(--brass);font-size:.73rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.instrument__copy h2{margin-top:.45rem;font-size:clamp(2rem,5vw,4.2rem);line-height:.95;letter-spacing:-.055em}.instrument__copy>div{display:grid;grid-template-columns:1fr auto;gap:2rem;margin-top:1.2rem}.instrument__copy>div>p{color:var(--ink-soft);max-width:58ch;line-height:1.65}.instrument__copy ul{list-style:none;display:flex;flex-wrap:wrap;gap:.4rem;align-content:start}.instrument__copy li{padding:.35rem .6rem;border:1px solid var(--line);border-radius:999px;color:var(--ink-faint);font-size:.68rem}.instrument-close{text-align:center}.instrument-close h2{margin:.7rem auto 1.5rem;max-width:12ch;font-size:clamp(2.4rem,6vw,5rem);line-height:.95;letter-spacing:-.06em}.instrument-close .section-label{justify-content:center}
  @media(max-width:760px){.instrument-head__grid{grid-template-columns:1fr}.instrument-head h1{font-size:clamp(2.65rem,12vw,3.8rem);line-height:.98}.instrument{grid-template-columns:2rem 6rem minmax(0,1fr)}.instrument__copy>div{grid-template-columns:1fr}.instrument__copy ul{grid-column:1/-1}}
  @media(max-width:520px){.instrument{grid-template-columns:2rem 1fr}.instrument__glyph{display:none}.instrument__copy{grid-column:2}}
</style>
