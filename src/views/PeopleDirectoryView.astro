---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/Reveal.astro";
import { Image } from "astro:assets";
import { SITE } from "../data/site";
import { current, past } from "../data/durbin-volunteers";
import lamiyaPortrait from "../assets/people/lamiya-ashraf-mowla.webp";
import asadPortrait from "../assets/people/khan-muhammad-bin-asad.webp";
import farzanaPortrait from "../assets/people/farzana-akter-lima.webp";

interface Props { mode: "management" | "volunteers" | "alumni" }
const { mode } = Astro.props;

const management = [
  {
    name: "Dr. Lamiya Ashraf Mowla",
    role: "Founder & Scientific Supervisor",
    affiliation: "Assistant Professor · Wellesley College",
    bio: "An observational astronomer studying how galaxies and their first star clusters formed since cosmic dawn using JWST and HST imaging.",
    image: lamiyaPortrait,
    links: [
      { label: "Personal website", href: "https://www.lamiyamowla.com/" },
      { label: "Publications", href: "https://ui.adsabs.harvard.edu/search/q=author%3A%22Mowla%2C%20Lamiya%22" },
    ],
    details: [
      { label: "Current appointment", value: "Assistant Professor, Department of Physics and Astronomy, Wellesley College, USA" },
      { label: "Education", value: "PhD, Yale University, USA" },
      { label: "Postdoctoral training", value: "Dunlap Institute for Astronomy and Astrophysics, University of Toronto, Canada" },
      { label: "Research", value: "The structural evolution of early-universe galaxies and their first star clusters using JWST and HST imaging" },
      { label: "Programmes", value: "JWST extragalactic teams, 3D-DASH, Bangladesh Science Outreach and Durbin" },
    ],
  },
  {
    name: "Dr. Khan Muhammad Bin Asad",
    role: "Scientific Supervisor",
    affiliation: "Assistant Professor · Independent University, Bangladesh",
    bio: "An astrophysicist probing cosmic dawn and reionization through the redshifted 21-cm signal, with research using LOFAR and MeerKAT.",
    image: asadPortrait,
    links: [
      { label: "Google Scholar", href: "https://scholar.google.com/scholar?q=Khan+Muhammad+Bin+Asad" },
      { label: "NASA ADS", href: "https://ui.adsabs.harvard.edu/search/q=author%3A%22Asad%2C%20Khan%20M.%20B.%22" },
    ],
    details: [
      { label: "Current appointment", value: "Assistant Professor, Department of Physical Sciences, Independent University, Bangladesh" },
      { label: "Education", value: "PhD, University of Groningen, Netherlands" },
      { label: "Postdoctoral training", value: "South African Radio Astronomy Observatory, South Africa" },
      { label: "Research", value: "Cosmic dawn and reionization through the redshifted 21-cm signal, plus diffuse radio halos in galaxy clusters" },
      { label: "Facilities", value: "LOFAR, MeerKAT, radio telescopes, scientific instruments and high-performance computing" },
    ],
  },
  {
    name: "Farzana Akter Lima",
    role: "Durbin Project Manager",
    affiliation: "Durbin · CASSA",
    bio: "Manages Durbin's programme delivery, partnerships and outreach operations as CASSA's dedicated Durbin project manager.",
    image: farzanaPortrait,
    links: [],
    details: [
      { label: "Current role", value: "Project Manager, Durbin" },
      { label: "Programme focus", value: "Project management and the Durbin astronomy-outreach programme" },
      { label: "Responsibilities", value: "Programme delivery, partnerships, volunteer coordination and public-outreach operations" },
      { label: "Contact", value: SITE.email },
    ],
  },
];

const profiles = mode === "management" ? management : mode === "volunteers"
  ? current.map((person) => ({
      name: person.name,
      role: "Durbin Volunteer · 2026",
      affiliation: person.institution ?? "Durbin",
      bio: "A member of Durbin's current astronomy-outreach and astrophotography cohort.",
      image: undefined,
      links: [],
      details: [
        { label: "Programme", value: "2026 Durbin volunteer cohort" },
        { label: "Institution", value: person.institution ?? "Durbin" },
        { label: "Region", value: person.region },
      ],
    }))
  : past.map((person) => ({
      name: person.name,
      role: "Durbin Alumni",
      affiliation: person.duration ?? "Past cohort",
      bio: "A former Durbin volunteer who contributed to the programme's outreach and observing work.",
      image: undefined,
      links: [],
      details: [
        { label: "Service", value: person.duration ?? "Past cohort" },
        { label: "Programme", value: "Durbin volunteer alumni network" },
        { label: "Region", value: person.region },
      ],
    }));

const labels = {
  management: { eyebrow: "People / Management", title: "Programme leadership", lede: "Scientific supervision and programme delivery are shown separately, reflecting their distinct responsibilities." },
  volunteers: { eyebrow: "People / Volunteers", title: "Current volunteers", lede: "The 2026 cohort carrying telescopes, images and astronomy stories into communities across Bangladesh." },
  alumni: { eyebrow: "People / Alumni", title: "Volunteer alumni", lede: "Past volunteers whose work helped build Durbin's observing, imaging and public-outreach practice." },
} as const;
const copy = labels[mode];
const initials = (name:string) => name.replace(/^(Dr\.|Md\.|MST\.)\s*/i, "").split(/\s+/).slice(0,2).map((part)=>part[0]).join("").toUpperCase();
const status = mode === "volunteers" ? "Current cohort" : mode === "alumni" ? "Alumni network" : "Leadership";
const profileGroups = mode === "management" ? [
  {
    slug: "supervisors",
    title: "Scientific supervisors",
    status: "Scientific supervision",
    profiles: management.slice(0, 2),
  },
  {
    slug: "project-manager",
    title: "Project manager",
    status: "Programme management",
    profiles: management.slice(2),
  },
] : [{ slug: mode, title: "", status, profiles }];
---

<BaseLayout path={`/people/${mode}`} title={`${copy.title} | Durbin`} current="/people" description={copy.lede}>
  <header class="people-directory-head">
    <div class="wrap people-directory-head__grid">
      <Reveal><p class="section-label">{copy.eyebrow}</p><h1>{copy.title}</h1></Reveal>
      <Reveal delay={70}><p>{copy.lede}</p><nav aria-label="People sections"><a class:list={[{active:mode==="management"}]} href="/people/management">Management</a><a class:list={[{active:mode==="volunteers"}]} href="/people/volunteers">Volunteers</a><a class:list={[{active:mode==="alumni"}]} href="/people/alumni">Alumni</a></nav></Reveal>
    </div>
  </header>

  <section class="section section--line people-directory" aria-label={copy.title}>
    <div class="wrap">
      {profileGroups.map((group) => <section class:list={["profile-group", `profile-group--${group.slug}`]}>
        {mode === "management" && (
          <header class="profile-group__head">
            <p class="section-label">{group.title}</p>
          </header>
        )}
        <div class:list={["profile-grid", `profile-grid--${group.slug}`]}>
        {group.profiles.map((profile) => {
          const profileData = {
            name: profile.name,
            role: profile.role,
            affiliation: profile.affiliation,
            bio: profile.bio,
            status: group.status,
            initials: initials(profile.name),
            image: profile.image?.src,
            links: profile.links,
            details: profile.details,
          };
          return <article class="profile-card">
            <div class:list={["profile-card__avatar", { "profile-card__avatar--photo": profile.image }]}>
              {profile.image
                ? <Image src={profile.image} alt={`Portrait of ${profile.name}`} widths={[180, 300]} sizes="160px" loading="lazy" />
                : <span role="img" aria-label={`Initials for ${profile.name}`}>{initials(profile.name)}</span>}
            </div>
            <div class="profile-card__body">
              <p class="profile-card__status">{group.status}</p>
              <h2>{profile.name}</h2>
              <p class="profile-card__role">{profile.role}</p>
              <p class="profile-card__affiliation">{profile.affiliation}</p>
              <button class="profile-card__more" type="button" data-profile-open data-profile={JSON.stringify(profileData)} aria-haspopup="dialog" aria-label={`More information about ${profile.name}`}>
                More info <span aria-hidden="true">↗</span>
              </button>
            </div>
          </article>;
        })}
        </div>
      </section>)}
      {mode !== "management" && <p class="profile-note">Cards use initials where no approved individual portrait is available.</p>}
    </div>
  </section>

  <dialog class="profile-modal" data-profile-modal aria-labelledby="profile-modal-title">
    <article class="profile-modal__card">
      <button class="profile-modal__close" type="button" data-profile-close aria-label="Close profile">×</button>
      <div class="profile-modal__cover" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="profile-modal__body">
        <header class="profile-modal__identity">
          <div class="profile-modal__avatar">
            <img src="" alt="" data-profile-image hidden />
            <span data-profile-initials></span>
          </div>
          <div class="profile-modal__copy">
            <p class="profile-modal__status" data-profile-status></p>
            <h2 id="profile-modal-title" data-profile-name></h2>
            <p class="profile-modal__role" data-profile-role></p>
            <p class="profile-modal__affiliation" data-profile-affiliation></p>
          </div>
        </header>
        <section class="profile-modal__section profile-modal__section--about" aria-labelledby="profile-modal-about">
          <div class="profile-modal__section-label">
            <h3 id="profile-modal-about">About</h3>
            <p>Profile overview and programme context.</p>
          </div>
          <p class="profile-modal__bio" data-profile-bio></p>
        </section>
        <section class="profile-modal__section" aria-labelledby="profile-modal-details-title">
          <div class="profile-modal__section-label">
            <h3 id="profile-modal-details-title">Profile details</h3>
            <p>Appointments, research and programme responsibilities.</p>
          </div>
          <dl class="profile-modal__details" data-profile-details></dl>
        </section>
        <footer class="profile-modal__footer">
          <p>External profiles and contact</p>
          <div class="profile-modal__links" data-profile-links>
            <a href={`mailto:${SITE.email}`} data-profile-email hidden>Email Durbin →</a>
          </div>
        </footer>
      </div>
    </article>
  </dialog>
</BaseLayout>

<script>
  type ProfileData = {
    name:string; role:string; affiliation:string; bio:string; status:string; initials:string;
    image?:string; links:Array<{label:string;href:string}>; details:Array<{label:string;value:string}>;
  };

  const setupProfileDialogs = () => {
    const dialog = document.querySelector<HTMLDialogElement>("[data-profile-modal]");
    if (!dialog || dialog.dataset.ready === "true") return;
    dialog.dataset.ready = "true";
    const closeButton = dialog.querySelector<HTMLButtonElement>("[data-profile-close]");
    const image = dialog.querySelector<HTMLImageElement>("[data-profile-image]");
    const initials = dialog.querySelector<HTMLElement>("[data-profile-initials]");
    const email = dialog.querySelector<HTMLAnchorElement>("[data-profile-email]");
    const links = dialog.querySelector<HTMLElement>("[data-profile-links]");
    const details = dialog.querySelector<HTMLElement>("[data-profile-details]");
    let opener:HTMLElement|null = null;

    document.querySelectorAll<HTMLButtonElement>("[data-profile-open]").forEach((button) => {
      button.addEventListener("click", () => {
        const profile = JSON.parse(button.dataset.profile ?? "{}") as ProfileData;
        opener = button;
        button.closest<HTMLElement>(".profile-card")?.removeAttribute("data-hover-suppressed");
        dialog.querySelector<HTMLElement>("[data-profile-name]")!.textContent = profile.name;
        dialog.querySelector<HTMLElement>("[data-profile-role]")!.textContent = profile.role;
        dialog.querySelector<HTMLElement>("[data-profile-affiliation]")!.textContent = profile.affiliation;
        dialog.querySelector<HTMLElement>("[data-profile-bio]")!.textContent = profile.bio;
        dialog.querySelector<HTMLElement>("[data-profile-status]")!.textContent = profile.status;
        if (profile.image) {
          image!.src = profile.image;
          image!.alt = `Portrait of ${profile.name}`;
          image!.hidden = false;
          initials!.hidden = true;
        } else {
          image!.hidden = true;
          image!.removeAttribute("src");
          initials!.textContent = profile.initials;
          initials!.hidden = false;
        }
        details!.replaceChildren(...profile.details.map(({label,value}) => {
          const row = document.createElement("div");
          const term = document.createElement("dt");
          const description = document.createElement("dd");
          term.textContent = label;
          description.textContent = value;
          row.append(term, description);
          return row;
        }));
        links!.querySelectorAll("[data-profile-external]").forEach((link) => link.remove());
        profile.links.forEach(({label,href}) => {
          const link = document.createElement("a");
          link.href = href;
          link.textContent = `${label} →`;
          link.target = "_blank";
          link.rel = "noopener";
          link.dataset.profileExternal = "";
          links!.prepend(link);
        });
        email!.hidden = profile.name !== "Farzana Akter Lima";
        dialog.showModal();
        closeButton?.focus();
      });
    });
    closeButton?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener("close", () => {
      const card = opener?.closest<HTMLElement>(".profile-card");
      if (card) {
        card.setAttribute("data-hover-suppressed", "");
        const releaseHover = () => card.removeAttribute("data-hover-suppressed");
        card.addEventListener("pointerleave", releaseHover, { once:true });
        card.addEventListener("pointerenter", releaseHover, { once:true });
      }
      opener?.focus();
    });
  };

  setupProfileDialogs();
  document.addEventListener("astro:page-load", setupProfileDialogs);
</script>

<style>
  .people-directory-head{padding:clamp(8rem,14vw,10rem) 0 clamp(2.5rem,5vw,4rem);background:radial-gradient(circle at 82% 20%,color-mix(in srgb,var(--brass) 15%,transparent),transparent 30%)}
  .people-directory-head__grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,8vw,7rem);align-items:end}.people-directory-head h1{margin-top:.75rem;max-width:14ch;font-size:clamp(2.7rem,6vw,5.2rem);line-height:.96;letter-spacing:-.06em}.people-directory-head__grid>div:last-child>p{max-width:55ch;color:var(--ink-soft);line-height:1.65}.people-directory-head nav{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1.25rem}.people-directory-head nav a{padding:.5rem .78rem;border:1px solid var(--line);border-radius:999px;color:var(--ink-faint);font-size:.74rem;font-weight:600}.people-directory-head nav a.active{color:var(--on-brass);background:var(--brass);border-color:var(--brass)}
  .people-directory{padding-top:clamp(2.25rem,4vw,3.75rem)}
  .profile-group+.profile-group{margin-top:clamp(3.5rem,7vw,6rem);padding-top:clamp(2rem,4vw,3rem);border-top:1px solid var(--line)}
  .profile-group__head{margin-bottom:1.4rem}
  .profile-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(2rem,4vw,4.5rem) clamp(1rem,2.8vw,2.2rem);align-items:start}
  .profile-grid--supervisors{grid-template-columns:repeat(2,minmax(11rem,15rem));max-width:36rem}.profile-grid--project-manager{grid-template-columns:minmax(11rem,15rem)}
  .profile-card{position:relative;isolation:isolate;display:flex;min-width:0;min-height:20.5rem;flex-direction:column;align-items:center;padding:.4rem .3rem 0;border:0;background:transparent;text-align:center;transition:transform .45s cubic-bezier(.22,1,.36,1)}
  .profile-card::before{content:"";position:absolute;z-index:-1;top:.7rem;left:50%;width:min(88%,10.5rem);aspect-ratio:.92;translate:-50% 0;border-radius:39% 61% 52% 48% / 58% 40% 60% 42%;background:linear-gradient(145deg,color-mix(in srgb,var(--brass) 84%,#0e78a6),color-mix(in srgb,var(--brass) 38%,#7444d8));box-shadow:inset 0 1px 0 rgba(255,255,255,.32);transform:rotate(-5deg) scale(.96);transition:transform .5s cubic-bezier(.22,1,.36,1),border-radius .5s cubic-bezier(.22,1,.36,1)}
  .profile-card:nth-child(3n+2)::before{border-radius:58% 42% 38% 62% / 43% 60% 40% 57%;transform:rotate(4deg) scale(.94)}.profile-card:nth-child(3n)::before{border-radius:44% 56% 61% 39% / 60% 46% 54% 40%;transform:rotate(-2deg) scale(.98)}
  .profile-card:hover:not([data-hover-suppressed]){transform:translateY(-5px)}.profile-card:hover:not([data-hover-suppressed])::before{border-radius:52% 48% 43% 57% / 44% 59% 41% 56%;transform:rotate(0) scale(1.03)}
  .profile-card__avatar{position:relative;z-index:1;width:min(86%,10rem);aspect-ratio:.9;display:grid;place-items:center;flex:0 0 auto;overflow:hidden;border:0;border-radius:42% 58% 48% 52% / 55% 44% 56% 45%;color:#fff;background:linear-gradient(145deg,#218f86,#174c59);box-shadow:none}.profile-card__avatar--photo{background:transparent}.profile-card__avatar :global(img){display:block;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center;filter:grayscale(1);transition:filter .45s cubic-bezier(.22,1,.36,1),transform .55s cubic-bezier(.22,1,.36,1)}.profile-card:hover:not([data-hover-suppressed]) .profile-card__avatar :global(img){filter:none;transform:scale(1.025)}.profile-card__avatar span{font-size:1.55rem;font-weight:750;letter-spacing:-.05em}
  .profile-card__body{display:flex;width:100%;min-width:0;flex:1;flex-direction:column;align-items:center;padding:.8rem .2rem 0}.profile-card__status,.profile-modal__status{color:var(--brass);font-size:.58rem;font-weight:750;text-transform:uppercase;letter-spacing:.1em}.profile-card h2{margin-top:.22rem;max-width:18ch;font-size:clamp(1rem,1.6vw,1.18rem);line-height:1.05;letter-spacing:-.025em;text-wrap:balance}.profile-card__role{margin-top:.3rem;max-width:25ch;color:var(--ink-soft);font-size:.69rem;line-height:1.35}.profile-card__affiliation{margin-top:.2rem;max-width:27ch;color:var(--ink-faint);font-size:.63rem;line-height:1.38;text-wrap:balance}.profile-card__more{display:inline-flex;align-items:center;justify-content:center;gap:.35rem;margin-top:.55rem;padding:.35rem .2rem;border:0;border-bottom:1px solid transparent;color:var(--ink);background:transparent;font-size:.64rem;font-weight:700;transition:border-color .2s,color .2s,transform .2s}.profile-card__more:hover{border-color:var(--brass);color:var(--brass);transform:translateY(-1px)}.profile-card__more:focus-visible{outline:2px solid var(--brass);outline-offset:4px;border-radius:.2rem}.profile-card__more span{color:var(--brass)}.profile-note{margin-top:1.5rem;color:var(--ink-faint);font-size:.72rem;line-height:1.5}
  .profile-modal{width:min(94vw,55rem);max-height:92svh;padding:0;overflow:auto;overscroll-behavior:contain;scrollbar-gutter:stable;border:1px solid var(--line);border-radius:clamp(1.5rem,4vw,2.4rem);color:var(--ink);background:var(--panel);box-shadow:0 35px 100px rgba(0,0,0,.48)}
  .profile-modal::backdrop{background:rgba(2,8,9,.82)}
  .profile-modal__card{position:relative;overflow:hidden;background:var(--panel)}
  .profile-modal__cover{position:relative;height:clamp(8.5rem,20vw,11.5rem);overflow:hidden;background:radial-gradient(circle at 18% 20%,rgba(190,255,242,.7),transparent 26%),radial-gradient(circle at 82% 18%,rgba(111,155,229,.52),transparent 28%),linear-gradient(135deg,#357f7b,#9adbd2 52%,#96abc8)}
  .profile-modal__cover::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.13),rgba(7,27,30,.08))}
  .profile-modal__cover span{position:absolute;border:1px solid rgba(255,255,255,.3);border-radius:50%}.profile-modal__cover span:nth-child(1){width:19rem;height:19rem;right:-4rem;top:-10rem}.profile-modal__cover span:nth-child(2){width:12rem;height:12rem;right:4rem;top:-6rem}.profile-modal__cover span:nth-child(3){width:.8rem;height:.8rem;left:14%;top:26%;border:0;background:#effffb;box-shadow:0 0 2rem rgba(255,255,255,.95)}
  .profile-modal__close{position:absolute;z-index:5;top:1rem;right:1rem;width:2.7rem;height:2.7rem;border:1px solid rgba(255,255,255,.36);border-radius:50%;color:#fff;background:rgba(5,18,22,.28);font-size:1.45rem;line-height:1;transition:background-color .2s,transform .2s}.profile-modal__close:hover{background:rgba(5,18,22,.62);transform:rotate(4deg)}
  .profile-modal__body{padding:0 clamp(1.25rem,5vw,3rem) clamp(1.5rem,4vw,2.5rem)}
  .profile-modal__identity{display:grid;grid-template-columns:8.5rem minmax(0,1fr);gap:1.4rem;align-items:start;margin-top:-4.35rem;padding:0 3.5rem 1.7rem 0}
  .profile-modal__copy{min-width:0;padding-top:5.15rem}
  .profile-modal__avatar{position:relative;z-index:2;width:8.5rem;height:8.5rem;display:grid;place-items:center;overflow:hidden;border:5px solid var(--panel);border-radius:50%;color:var(--ink);background:var(--panel-2);box-shadow:0 14px 32px rgba(0,0,0,.2)}.profile-modal__avatar img{display:block;width:100%;height:100%;max-width:100%;object-fit:cover;object-position:center}.profile-modal__avatar span{font-size:2rem;font-weight:750}.profile-modal__body h2{margin-top:.35rem;font-size:clamp(1.7rem,4.5vw,2.65rem);line-height:1.02;letter-spacing:-.045em}.profile-modal__role{margin-top:.42rem;color:var(--ink-soft);font-size:.9rem;font-weight:650}.profile-modal__affiliation{margin-top:.24rem;color:var(--ink-faint);font-size:.78rem}
  .profile-modal__section{display:grid;grid-template-columns:minmax(9rem,12rem) minmax(0,1fr);gap:clamp(1.25rem,4vw,3rem);padding:1.45rem 0;border-top:1px solid var(--line)}.profile-modal__section-label h3{font-size:.92rem;line-height:1.2}.profile-modal__section-label p{margin-top:.35rem;max-width:18ch;color:var(--ink-faint);font-size:.68rem;line-height:1.45}.profile-modal__bio{max-width:62ch;color:var(--ink-soft);font-size:.86rem;line-height:1.65}
  .profile-modal__details{display:grid;gap:.6rem;text-align:left}.profile-modal__details div{display:grid;grid-template-columns:minmax(7.5rem,9rem) minmax(0,1fr);gap:1rem;align-items:start;padding:.78rem .9rem;border:1px solid var(--line);border-radius:.9rem;background:var(--panel-2)}.profile-modal__details dt{color:var(--ink-faint);font-size:.67rem;line-height:1.45}.profile-modal__details dd{color:var(--ink);font-size:.76rem;font-weight:600;line-height:1.5;overflow-wrap:anywhere}
  .profile-modal__footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-top:1.35rem;border-top:1px solid var(--line)}.profile-modal__footer>p{color:var(--ink-faint);font-size:.68rem}.profile-modal__links{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.55rem}.profile-modal__links a{padding:.62rem .85rem;border:1px solid var(--line);border-radius:.75rem;color:var(--ink);background:var(--panel-2);font-size:.7rem;font-weight:750;transition:border-color .2s,color .2s}.profile-modal__links a:hover{border-color:var(--brass);color:var(--brass)}
