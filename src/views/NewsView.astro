---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/Reveal.astro";
import { fmtDate } from "../lib/format";
const posts=(await getCollection("news",({data})=>data.status!=="draft")).sort((a,b)=>+b.data.date-+a.data.date);
const lead=posts[0];const secondary=posts.slice(1,3);const archive=posts.slice(3);
---

<BaseLayout path="/news" title="News | Durbin" current="/news" description="Stories from Durbin's astronomy outreach, volunteers and observing programmes across Bangladesh.">
  <header class="news-head"><div class="wrap"><Reveal><p class="section-label">News</p><h1>Stories from<br/>a shared sky.</h1><p>Field notes, programme updates and the people bringing astronomy closer across Bangladesh.</p><a class="news-all" href="#all-stories">View all stories <span aria-hidden="true">↓</span></a></Reveal></div></header>
  {lead&&<section class="news-lead section--line"><div class="wrap news-lead__grid">
    <Reveal class="news-lead__media">{lead.data.hero&&<Image src={lead.data.hero} alt={lead.data.heroAlt??""} widths={[700,1100,1500]} sizes="(max-width:800px) 100vw, 58vw" loading="eager"/>}</Reveal>
    <Reveal class="news-lead__copy" delay={80}><p class="news-kicker">Latest · <time datetime={lead.data.date.toISOString()}>{fmtDate(lead.data.date)}</time></p><h2><a href={`/news/${lead.id}`}>{lead.data.title}</a></h2>{lead.data.summary&&<p>{lead.data.summary}</p>}<a class="news-read" href={`/news/${lead.id}`}>Read the story →</a></Reveal>
  </div></section>}
  <section class="section news-grid-section"><div class="wrap"><Reveal><p class="section-label">More from Durbin</p><h2 class="news-section-title">Recent news</h2></Reveal><div class="news-grid">
    {secondary.map((post,i)=><article class="news-card" data-reveal style={`--reveal-delay:${i*60}ms`}><a href={`/news/${post.id}`}>{post.data.hero&&<span class="news-card__media"><Image src={post.data.hero} alt={post.data.heroAlt??""} widths={[500,800,1100]} sizes="(max-width:700px) 100vw, 50vw" loading="lazy"/></span>}<span class="news-card__body"><span class="news-kicker">{post.data.category??"News"} · <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time></span><strong>{post.data.title}</strong>{post.data.summary&&<span class="news-card__summary">{post.data.summary}</span>}<span class="news-read">Read →</span></span></a></article>)}
  </div></div></section>
  <section class="section section--line news-archive" id="all-stories"><div class="wrap"><Reveal><p class="section-label">Archive</p><h2 class="news-section-title">All stories</h2></Reveal><ol>
    {archive.map((post,i)=><li data-reveal style={`--reveal-delay:${Math.min(i,8)*30}ms`}><a href={`/news/${post.id}`}><time datetime={post.data.date.toISOString()}><span>{post.data.date.toLocaleDateString("en-GB",{day:"2-digit"})}</span>{post.data.date.toLocaleDateString("en-GB",{month:"short",year:"numeric"})}</time><span class="news-archive__category">{post.data.category??"News"}</span><strong>{post.data.title}</strong><span aria-hidden="true">↗</span></a></li>)}
  </ol></div></section>
</BaseLayout>

<style>
  .news-head{padding:clamp(8rem,14vw,10rem) 0 clamp(3.5rem,7vw,5.5rem);background:linear-gradient(120deg,color-mix(in srgb,var(--brass) 12%,transparent),transparent 48%)}.news-head :global(.is-in){display:grid;justify-items:start;max-width:52rem}.news-head h1{margin-top:.8rem;max-width:13ch;font-size:clamp(2.65rem,6vw,4.75rem);line-height:.98;letter-spacing:-.055em;text-wrap:balance}.news-head h1+p{margin-top:1.25rem;max-width:55ch;color:var(--ink-soft);font-size:clamp(.98rem,1.4vw,1.08rem);line-height:1.62}.news-all{display:inline-flex;align-items:center;gap:.6rem;min-height:44px;margin-top:1.5rem;padding:.7rem 1rem;border:1px solid var(--line);border-radius:999px;color:var(--ink);font-size:.78rem;font-weight:700;background:var(--panel)}.news-all:hover{border-color:var(--brass);color:var(--brass)}
  .news-lead{padding:clamp(3rem,7vw,6rem) 0}.news-lead__grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,6vw,5rem);align-items:center}.news-lead__media{display:block;overflow:hidden;border-radius:var(--radius-card);aspect-ratio:16/11;background:var(--panel)}.news-lead__media :global(img){width:100%;height:100%;object-fit:cover}.news-kicker{color:var(--brass);font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em}.news-lead h2{margin-top:.8rem;font-size:clamp(2rem,4vw,3.6rem);line-height:1;letter-spacing:-.05em}.news-lead__copy>p:not(.news-kicker){margin-top:1rem;color:var(--ink-soft);line-height:1.65}.news-read{display:inline-block;margin-top:1.25rem;color:var(--brass);font-size:.78rem;font-weight:700}
  .news-section-title{margin-top:.55rem;font-size:clamp(2.4rem,5vw,4rem);line-height:.95;letter-spacing:-.055em}.news-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:2.2rem}.news-card{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-card);background:var(--panel)}.news-card>a{display:grid}.news-card__media{aspect-ratio:16/9;overflow:hidden}.news-card__media :global(img){width:100%;height:100%;object-fit:cover;transition:transform .55s}.news-card:hover .news-card__media :global(img){transform:scale(1.03)}.news-card__body{display:flex;flex-direction:column;align-items:flex-start;padding:1.4rem}.news-card strong{margin-top:.6rem;font-size:1.35rem;line-height:1.2}.news-card__summary{margin-top:.65rem;color:var(--ink-soft);font-size:.88rem;line-height:1.55}.news-card .news-read{margin-top:1rem}
  .news-archive ol{list-style:none;margin-top:2rem;border-top:1px solid var(--line)}.news-archive li{border-bottom:1px solid var(--line)}.news-archive li a{display:grid;grid-template-columns:6.5rem 7rem minmax(0,1fr) auto;gap:1rem;align-items:center;padding:1.2rem 0}.news-archive time{display:grid;color:var(--ink-faint);font-size:.7rem;text-transform:uppercase}.news-archive time span{color:var(--ink);font-family:var(--font-mono);font-size:1.35rem;line-height:1}.news-archive__category{color:var(--brass);font-size:.72rem;font-weight:700}.news-archive strong{font-size:1rem}.news-archive li a>span:last-child{color:var(--ink-faint)}
  @media(max-width:760px){.news-head h1{max-width:12ch;font-size:clamp(2.3rem,9.5vw,3.15rem);line-height:1}.news-head h1+p{margin-top:1.1rem}.news-all{margin-top:1.25rem}.news-lead__grid,.news-grid{grid-template-columns:1fr}.news-archive li a{grid-template-columns:4rem minmax(0,1fr) auto}.news-archive__category{display:none}}
</style>
