---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/Reveal.astro";
import { fmtDate, fmtTime } from "../lib/format";

const events=(await getCollection("events",({data})=>data.status!=="draft")).sort((a,b)=>+b.data.start-+a.data.start);
const now=new Date();const upcoming=events.filter(event=>event.data.start>=now).sort((a,b)=>+a.data.start-+b.data.start);const past=events.filter(event=>event.data.start<now);
const focus=upcoming[0]?.data.start??events[0]?.data.start??now;const year=focus.getUTCFullYear();const month=focus.getUTCMonth();
const monthName=focus.toLocaleDateString("en-GB",{month:"long",year:"numeric",timeZone:"UTC"});const firstDay=new Date(Date.UTC(year,month,1)).getUTCDay();const daysInMonth=new Date(Date.UTC(year,month+1,0)).getUTCDate();const cellCount=Math.ceil((firstDay+daysInMonth)/7)*7;
const calendar=Array.from({length:cellCount},(_,index)=>{const day=index-firstDay+1;if(day<1||day>daysInMonth)return null;const date=new Date(Date.UTC(year,month,day));const onDay=events.filter(event=>{const start=new Date(Date.UTC(event.data.start.getUTCFullYear(),event.data.start.getUTCMonth(),event.data.start.getUTCDate()));const rawEnd=event.data.end??event.data.start;const end=new Date(Date.UTC(rawEnd.getUTCFullYear(),rawEnd.getUTCMonth(),rawEnd.getUTCDate()));return date>=start&&date<=end});return{day,date,onDay}});
const years=[...new Set(past.map(event=>event.data.start.getUTCFullYear()))];
---

<BaseLayout path="/events" title="Events & Calendar | Durbin" current="/events" description="Durbin workshops, public astronomy nights, talks and outreach events.">
  <header class="events-head"><div class="wrap"><Reveal><p class="section-label">Events</p><h1>Events &amp;<br/>Calendar</h1><p>Workshops, public astronomy nights and outreach across Bangladesh—browse what’s ahead and the full archive.</p></Reveal></div></header>
  <section class="section section--line calendar-section"><div class="wrap"><Reveal><p class="section-label">What’s on</p><div class="calendar-title"><h2>Calendar</h2><p class="mono">{monthName}</p></div></Reveal>
    <div class="calendar" aria-label={`Events calendar for ${monthName}`}>
      <div class="calendar__weekdays" aria-hidden="true">{["Sun","Mon","Tue","Wed","Thu","Fri","Sat"].map(day=><span>{day}</span>)}</div>
      <ol>{calendar.map(cell=><li class:list={[{empty:!cell,hasEvent:cell?.onDay.length}]}>{cell&&<><time datetime={cell.date.toISOString().slice(0,10)}>{cell.day}</time><div>{cell.onDay.map(event=><a href={`/events/${event.id}`} title={event.data.title}><span>{fmtTime(event.data.start)}</span>{event.data.title}</a>)}</div></>}</li>)}</ol>
    </div>
    <div class="event-legend"><span>Astronomy night</span><span>Workshop</span><span>Outreach</span><span>Talk</span></div>
  </div></section>
  <section class="section section--line upcoming"><div class="wrap"><Reveal><p class="section-label">What’s on</p><h2>Upcoming</h2></Reveal>
    {upcoming.length?<ol>{upcoming.map(event=><li><a href={`/events/${event.id}`}><time datetime={event.data.start.toISOString()}><span>{event.data.start.toLocaleDateString("en-GB",{day:"2-digit"})}</span>{event.data.start.toLocaleDateString("en-GB",{month:"short"})}</time><span>{event.data.category??"Event"}</span><strong>{event.data.title}</strong><span>{event.data.venue??"Details online"}</span></a></li>)}</ol>:<p class="upcoming__empty">No upcoming events are scheduled right now—explore the archive below, and check back soon.</p>}
  </div></section>
  <section class="section section--line event-archive"><div class="wrap"><Reveal><p class="section-label">Archive</p><h2>Past events</h2></Reveal>
    {years.map(eventYear=><section class="event-year"><h3>{eventYear}</h3><ol>{past.filter(event=>event.data.start.getUTCFullYear()===eventYear).map(event=><li><a href={`/events/${event.id}`}><time datetime={event.data.start.toISOString()}><span>{event.data.start.toLocaleDateString("en-GB",{day:"2-digit"})}</span>{event.data.start.toLocaleDateString("en-GB",{month:"short"})}</time><span class="event-year__type">{event.data.category??"Event"}</span><span class="event-year__main"><strong>{event.data.title}</strong><small>{event.data.venue??"Details online"}</small></span><span aria-hidden="true">↗</span></a></li>)}</ol></section>)}
  </div></section>
</BaseLayout>

<style>
  .events-head{padding:clamp(8rem,14vw,10rem) 0 clamp(3.5rem,7vw,5.5rem);background:radial-gradient(circle at 80% 60%,color-mix(in srgb,var(--brass) 16%,transparent),transparent 28%)}.events-head :global(.is-in){display:grid;justify-items:start;max-width:54rem}.events-head h1{margin-top:.8rem;max-width:12ch;font-size:clamp(2.75rem,6.8vw,5.4rem);line-height:.94;letter-spacing:-.06em;text-wrap:balance}.events-head>div>div>p:last-child{margin-top:1.25rem;max-width:58ch;color:var(--ink-soft);font-size:clamp(.98rem,1.4vw,1.08rem);line-height:1.62}
  .calendar-title{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-top:.45rem}.calendar-title h2,.upcoming h2,.event-archive>div>div>h2{font-size:clamp(2.5rem,5vw,4rem);line-height:.95;letter-spacing:-.055em}.calendar-title p{color:var(--ink-faint);font-size:.78rem}.calendar{margin-top:2rem;border:1px solid var(--line);border-radius:var(--radius-card);overflow:hidden;background:var(--panel)}.calendar__weekdays{display:grid;grid-template-columns:repeat(7,1fr);border-bottom:1px solid var(--line)}.calendar__weekdays span{padding:.65rem;color:var(--ink-faint);font-size:.68rem;text-align:center}.calendar ol{list-style:none;display:grid;grid-template-columns:repeat(7,1fr)}.calendar li{min-height:8.3rem;padding:.55rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden}.calendar li:nth-child(7n){border-right:0}.calendar li time{display:block;color:var(--ink-faint);font-family:var(--font-mono);font-size:.72rem}.calendar li.hasEvent time{color:var(--brass)}.calendar li div{display:grid;gap:.3rem;margin-top:.45rem}.calendar li a{display:grid;gap:.06rem;padding:.35rem;border-left:2px solid var(--brass);background:color-mix(in srgb,var(--brass) 10%,transparent);color:var(--ink);font-size:.64rem;line-height:1.25}.calendar li a span{color:var(--ink-faint);font-family:var(--font-mono);font-size:.56rem}.event-legend{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1rem;color:var(--ink-faint);font-size:.68rem}.event-legend span:before{content:"";display:inline-block;width:7px;height:7px;margin-right:.35rem;border-radius:50%;background:var(--brass)}
  .upcoming ol,.event-year ol{list-style:none;margin-top:2rem;border-top:1px solid var(--line)}.upcoming li,.event-year li{border-bottom:1px solid var(--line)}.upcoming li a{display:grid;grid-template-columns:4.5rem 8rem minmax(0,1fr) minmax(10rem,.7fr);gap:1rem;align-items:center;padding:1.2rem 0}.upcoming time,.event-year time{display:grid;color:var(--ink-faint);font-size:.7rem;text-transform:uppercase}.upcoming time span,.event-year time span{color:var(--ink);font-family:var(--font-mono);font-size:1.45rem;line-height:1}.upcoming li a>span:nth-child(2){color:var(--brass);font-size:.7rem;font-weight:700}.upcoming li a>span:last-child{color:var(--ink-faint);font-size:.74rem}.upcoming__empty{margin-top:2rem;padding:1.5rem;border:1px solid var(--line);border-radius:var(--radius-md);color:var(--ink-soft);background:var(--panel)}
  .event-year{margin-top:3rem}.event-year h3{font-family:var(--font-mono);font-size:1rem;color:var(--brass)}.event-year li a{display:grid;grid-template-columns:4.5rem 8rem minmax(0,1fr) auto;gap:1rem;align-items:center;padding:1rem 0}.event-year__type{color:var(--brass);font-size:.7rem;font-weight:700}.event-year__main{display:grid;gap:.25rem}.event-year__main strong{font-size:.95rem}.event-year__main small{color:var(--ink-faint);font-size:.7rem}.event-year li a>span:last-child{color:var(--ink-faint)}
  @media(max-width:800px){.events-head h1{font-size:clamp(2.65rem,12vw,3.8rem);line-height:.98}.calendar{overflow-x:auto}.calendar__weekdays,.calendar ol{min-width:47rem}.upcoming li a{grid-template-columns:4rem minmax(0,1fr)}.upcoming li a>span:nth-child(2),.upcoming li a>span:last-child{display:none}.event-year li a{grid-template-columns:3.7rem minmax(0,1fr) auto}.event-year__type{display:none}}
</style>
