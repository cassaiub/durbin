# durbin.cc — server config for the static build.
#
# This file ships FROM THE REPO: it lands in dist/ and rsync copies it into the
# document root (~/durbin.cc). Nothing in that directory is cPanel-generated,
# so there is no server-side copy to preserve. Edit it here, never on the
# server, or the next deploy will overwrite the change.

# Bluehost fronts Apache with an nginx proxy cache that stores HTML for eight
# hours when the origin advertises a cache level (the header below is what it
# reads; public_html/.htaccess sets it to "2" for cassa-site). At that TTL a
# deploy stays invisible on any already-visited URL for most of a day, which
# is indistinguishable from a broken deploy. Opt this site out: it is small,
# static, and republished often, so freshness beats edge caching. Assets under
# /_astro/ are content-hashed, so the browser cache still does the real work.
<IfModule mod_headers.c>
  Header set X-Endurance-Cache-Level "0"
</IfModule>

# Astro builds directory-style pages (/exhibition/index.html) while emitting
# links and canonical URLs WITHOUT a trailing slash (trailingSlash: "never" in
# astro.config.mjs). Left alone, mod_dir answers /exhibition with a 301 to
# /exhibition/, which contradicts the canonical and puts a redirect in front of
# every internal link. Serve the index file directly at the no-slash URL.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical origin: https, no www — matching the canonical URLs the
  # build emits. Despite the nginx proxy in front, Apache is handed the real
  # scheme (verified: HTTPS=on and SERVER_PORT=443 on a TLS request, unset/80
  # on a plain one), so %{HTTPS} is trustworthy and cannot loop here — the
  # redirect target always satisfies both conditions. cPanel's own "Force
  # HTTPS Redirect" is also enabled for this domain, but it does not take
  # effect on this vhost, so this rule is what actually does the work.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.durbin\.cc$ [NC]
  RewriteRule ^(.*)$ https://durbin.cc/$1 [R=301,L]

  # /exhibition -> /exhibition/index.html, internally, no redirect.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]

  # A visitor or an old inbound link supplying the trailing slash is sent to
  # the canonical no-slash URL, so each page answers on exactly one address.
  # "/" itself is exempt. This cannot loop: the rule above rewrites internally
  # rather than redirecting.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]
</IfModule>

# The build emits a styled 404 page; without this Apache serves its own.
ErrorDocument 404 /404.html

# DirectorySlash Off must never be paired with directory listings.
Options -Indexes
